{
  "name": "@manthan/svelte",
  "version": "0.1.0",
  "description": "Manthan UI for Svelte 5: accessible components in 11 design styles, powered by Tailwind CSS v4.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tech-manthan/manthan-svelte"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "dev": "vite playground",
    "build:playground": "vite build playground",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@manthan/base": "^0.1.0",
    "@manthan/icons": "^0.1.0",
    "svelte": "^5.20.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@manthan/base": "file:../manthan-base",
    "@manthan/icons": "file:../manthan-icons",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
